@page "/Resource"

<PortfolioScaffold PageTitle="Resident Resources" PageSubtitle="Quick launchpad for the links I rely on every day">
    <MudGrid Class="g-4">
        <MudItem xs="12" md="7">
            <MudPaper Elevation="1" Class="glass-panel p-4">
                <MudText Typo="Typo.h5" Class="mb-3">Resources</MudText>
                <MudList Dense="true">
                    @foreach (var resource in Resources)
                    {
                        <MudListItem Icon="@resource.Icon" IconColor="Color.Primary" Href="@resource.Url" Target="_blank">
                            <MudText Typo="Typo.subtitle1">@resource.Title</MudText>
                            <MudText Class="text-muted">@resource.Description</MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Elevation="1" Class="gradient-border p-4">
                <MudText Typo="Typo.h5" Class="mb-2">Campus pulse</MudText>
                <MudTimeline>
                    <MudTimelineItem Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" TextColor="Color.Primary">
                        <div class="mb-1 fw-semibold">Speedy access</div>
                        <div class="text-muted">Launch the most-used services with one tap.</div>
                    </MudTimelineItem>
                    <MudTimelineItem Icon="@Icons.Material.Filled.Security" Color="Color.Secondary">
                        <div class="mb-1 fw-semibold">Secure navigation</div>
                        <div class="text-muted">Links open in new tabs so you never lose your place.</div>
                    </MudTimelineItem>
                    <MudTimelineItem Icon="@Icons.Material.Filled.Waves" Color="Color.Primary">
                        <div class="mb-1 fw-semibold">Neon aesthetic</div>
                        <div class="text-muted">Dark canvas with neon blue accents keeps things readable.</div>
                    </MudTimelineItem>
                </MudTimeline>
            </MudPaper>
        </MudItem>
    </MudGrid>
</PortfolioScaffold>

