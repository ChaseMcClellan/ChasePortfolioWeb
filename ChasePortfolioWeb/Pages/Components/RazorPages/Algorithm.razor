@page "/Algorithms"

<PortfolioScaffold PageTitle="Algorithm Playground" PageSubtitle="Interactive MudBlazor-powered utilities with live feedback">
    <MudGrid Class="g-4 mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="glass-panel p-4">
                <MudText Typo="Typo.h5" Class="mb-2">Pick an algorithm</MudText>
                <MudText Class="mb-3 text-muted">Instantly explore logic in a neon themed lab.</MudText>
                <MudSelect T="string" @bind-Value="selectedAlgorithm" Label="Algorithm" Color="Color.Primary">
                    <MudSelectItem Value="DigitalRoot">Digital Root</MudSelectItem>
                    <MudSelectItem Value="Fibonacci">Fibonacci</MudSelectItem>
                    <MudSelectItem Value="Factorial">Factorial</MudSelectItem>
                    <MudSelectItem Value="BinarySearch">Binary Search</MudSelectItem>
                    <MudSelectItem Value="BST">Binary Search Tree</MudSelectItem>
                </MudSelect>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="gradient-border p-4">
                <MudText Typo="Typo.h5" Class="mb-2">Why this matters</MudText>
                <MudList Dense="true">
                    <MudListItem Icon="@Icons.Material.Filled.FlashOn" IconColor="Color.Primary">Responsive MudBlazor inputs with live validation.</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.GridView" IconColor="Color.Primary">SVG visualization styled by the neon palette.</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Hub" IconColor="Color.Primary">Server-side compute with instant UI updates.</MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudSlide Transition="Transition.SlideUp">
        <MudPaper Elevation="1" Class="glass-panel p-4 mb-6">
            @if (selectedAlgorithm == "DigitalRoot")
            {
                <MudText Typo="Typo.h5" Class="mb-2">Digital Root</MudText>
                <MudNumericField @bind-Value="n" Label="Number" Required="true" Color="Color.Primary" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Pin" Class="mb-3" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Calculate" OnClick="DigitalRootManager">Compute</MudButton>
                <MudAlert Severity="Severity.Info" Class="mt-3">Digital root: <strong>@rootNumber</strong></MudAlert>
            }
            else if (selectedAlgorithm == "Fibonacci")
            {
                <MudText Typo="Typo.h5" Class="mb-2">Fibonacci</MudText>
                <MudNumericField @bind-Value="n" Label="Index" Required="true" Color="Color.Primary" Class="mb-3" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Calculate" OnClick="FibonacciManager">Compute</MudButton>
                <MudAlert Severity="Severity.Info" Class="mt-3">Fibonacci number: <strong>@fibNumber</strong></MudAlert>
            }
            else if (selectedAlgorithm == "Factorial")
            {
                <MudText Typo="Typo.h5" Class="mb-2">Factorial</MudText>
                <MudNumericField @bind-Value="n" Label="Input" Required="true" Color="Color.Primary" Class="mb-3" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Calculate" OnClick="FactorialManager">Compute</MudButton>
                <MudAlert Severity="Severity.Info" Class="mt-3">Factorial: <strong>@factNumber</strong></MudAlert>
            }
            else if (selectedAlgorithm == "BinarySearch")
            {
                <MudText Typo="Typo.h5" Class="mb-2">Binary Search</MudText>
                <MudTextField @bind-Value="inputArray" Label="Comma separated numbers" Color="Color.Primary" Placeholder="2,4,6,8,10" />
                <MudNumericField @bind-Value="target" Label="Target" Color="Color.Primary" Class="mt-2" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Class="mt-2" OnClick="BinarySearchManager">Search</MudButton>
                <MudAlert Severity="Severity.Info" Class="mt-3">@binarySearchResult</MudAlert>
            }
            else if (selectedAlgorithm == "BST")
            {
                <MudText Typo="Typo.h5" Class="mb-2">Binary Search Tree</MudText>
                <MudNumericField @bind-Value="bstValue" Label="Value to insert" Color="Color.Primary" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Class="mt-2" OnClick="InsertValueIntoBST">Insert</MudButton>
                <MudAlert Severity="Severity.Info" Class="mt-3">Tap Insert to grow the neon tree.</MudAlert>
                <MudPaper Elevation="0" Class="mt-4 gradient-border p-3">
                    <svg width="100%" height="320">
                        @foreach (var edge in edges)
                        {
                            <line x1="@edge.X1" y1="@edge.Y1" x2="@edge.X2" y2="@edge.Y2" stroke="#38B6FF" stroke-width="2" opacity="0.6" />
                        }
                        @foreach (var node in nodes)
                        {
                            <circle cx="@node.X" cy="@node.Y" r="18" stroke="#60A5FA" stroke-width="2" fill="rgba(56, 182, 255, 0.2)" />
                            @:<text x="@node.X" y="@node.Y + 5" text-anchor="middle" font-size="12" fill="#E2E8F0">@node.Value</text>
                        }
                    </svg>
                </MudPaper>
            }
        </MudPaper>
    </MudSlide>
</PortfolioScaffold>

@code {
    private string selectedAlgorithm = "DigitalRoot";
    private int n;

    private int rootNumber;
    private void DigitalRootManager() => rootNumber = DigitalRoot(n);
    private int DigitalRoot(int value) => value < 10 ? value : DigitalRoot(value % 10 + DigitalRoot(value / 10));

    private int fibNumber;
    private void FibonacciManager() => fibNumber = Fibonacci(n);
    private int Fibonacci(int value) => value <= 1 ? value : Fibonacci(value - 1) + Fibonacci(value - 2);

    private int factNumber;
    private void FactorialManager() => factNumber = Factorial(n);
    private int Factorial(int value) => value == 0 ? 1 : value * Factorial(value - 1);

    private string inputArray = string.Empty;
    private int target;
    private string binarySearchResult = "Awaiting input...";

    private void BinarySearchManager()
    {
        try
        {
            int[] array = inputArray.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(int.Parse).OrderBy(x => x).ToArray();
            int resultIndex = BinarySearch(array, target);
            binarySearchResult = resultIndex != -1
                ? $"Found at index {resultIndex} in the sorted array."
                : "Not found in the array.";
        }
        catch
        {
            binarySearchResult = "Invalid input. Use commas between numbers.";
        }
    }

    private int BinarySearch(int[] array, int targetValue)
    {
        int left = 0;
        int right = array.Length - 1;
        while (left <= right)
        {
            int mid = left + (right - left) / 2;
            if (array[mid] == targetValue) return mid;
            if (array[mid] < targetValue) left = mid + 1; else right = mid - 1;
        }
        return -1;
    }

    private int bstValue;
    private BSTNode? root;
    private readonly List<BSTNodePosition> nodes = new();
    private readonly List<BSTEdge> edges = new();

    private class BSTNode
    {
        public int Value { get; set; }
        public BSTNode? Left { get; set; }
        public BSTNode? Right { get; set; }

        public BSTNode(int value) => Value = value;
    }

    private class BSTNodePosition
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Value { get; set; }
    }

    private class BSTEdge
    {
        public int X1 { get; set; }
        public int Y1 { get; set; }
        public int X2 { get; set; }
        public int Y2 { get; set; }
    }

    private void InsertValueIntoBST()
    {
        root = InsertNode(root, bstValue);
        nodes.Clear();
        edges.Clear();
        CalculateNodePositions(root, 400, 30, 260);
    }

    private BSTNode InsertNode(BSTNode? node, int value)
    {
        if (node == null) return new BSTNode(value);
        if (value < node.Value) node.Left = InsertNode(node.Left, value);
        else if (value > node.Value) node.Right = InsertNode(node.Right, value);
        return node;
    }

    private void CalculateNodePositions(BSTNode? node, int x, int y, int spacing)
    {
        if (node == null) return;
        nodes.Add(new BSTNodePosition { X = x, Y = y, Value = node.Value });
        if (node.Left != null)
        {
            edges.Add(new BSTEdge { X1 = x, Y1 = y, X2 = x - spacing / 2, Y2 = y + 80 });
            CalculateNodePositions(node.Left, x - spacing / 2, y + 80, spacing / 2);
        }
        if (node.Right != null)
        {
            edges.Add(new BSTEdge { X1 = x, Y1 = y, X2 = x + spacing / 2, Y2 = y + 80 });
            CalculateNodePositions(node.Right, x + spacing / 2, y + 80, spacing / 2);
        }
    }
}
