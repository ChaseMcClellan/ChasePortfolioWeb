<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="~/ChasePortfolioWeb.styles.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            font-family: 'Space Grotesk', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at 10% 20%, rgba(56, 182, 255, 0.12), transparent 25%),
                        radial-gradient(circle at 90% 10%, rgba(30, 64, 175, 0.12), transparent 25%),
                        radial-gradient(circle at 70% 80%, rgba(14, 165, 233, 0.08), transparent 28%),
                        #050914;
            color: #e7f5ff;
            min-height: 100vh;
        }
        a { color: inherit; }
    </style>
</head>
<body>
    @RenderBody()

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
